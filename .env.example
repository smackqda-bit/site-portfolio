# Public canonical origin. No trailing slash. Configure before production build.
NEXT_PUBLIC_SITE_URL=
# Real public contact address; leave blank until supplied.
NEXT_PUBLIC_CONTACT_EMAIL=

# Resend: verified sender domain and actual inbox. Never prefix secrets with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Required in production. Register the site's hostname with Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Required in production for an atomic, shared 3 requests / 15 minutes limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: only set to an IP header your trusted reverse proxy OVERWRITES.
# Do not trust arbitrary client-provided X-Forwarded-For.
CONTACT_TRUSTED_IP_HEADER=
